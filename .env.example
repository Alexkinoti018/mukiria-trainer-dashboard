# ==============================================================================
# Mukiria Technical Training Institute (MTTI) / Nolimit
# Production & Local Development Environment Variables
# ==============================================================================

# ─── CLIENT-SIDE SUPABASE CONFIGURATION (Exposed to Browser via Vite) ─────────
# Full HTTPS URL to your Supabase project REST & GraphQL gateway
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Public anonymous key for client authentication and row-level security
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── SERVER-SIDE POSTGRESQL & BACKEND GATEWAY CONFIGURATION ───────────────────
# Application Service Role Connection String (mtti_app via Supabase PgBouncer pooler on port 6543)
DATABASE_URL=postgresql://mtti_app:your-secure-mtti-app-password@your-project-ref.pooler.supabase.com:6543/postgres?sslmode=require

# Direct PostgreSQL connection string for running administrative migrations as postgres:
# ADMIN_DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# Alternatively, configure Supabase password directly if assembling connection string:
# SUPABASE_PROJECT_REF=your-project-id
# SUPABASE_DB_PASSWORD=your-secure-password

# Optional: Service Role Key for elevated backend migrations (NEVER expose to client)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── CRYPTOGRAPHIC AUTHENTICATION & ACCESS CONTROL (CRITICAL) ─────────────────
# Mandatory cryptographic signing secret for HS256 tokens (min 32 characters).
# Generate using: openssl rand -base64 48
# MUST be set in Vercel environment settings for BOTH Production and Preview.
JWT_SECRET=replace_with_openssl_rand_base64_48_secret_here

# Tamper-evident cryptographic signing key for broadsheets & official documents (min 32 characters)
DOCUMENT_SIGNING_KEY_CURRENT=replace_with_openssl_rand_base64_48_signing_key_here

# Optional: Previous document signing key during 90-day key rotation grace period
# DOCUMENT_SIGNING_KEY_PREVIOUS=previous_rotated_document_signing_key_here

# Optional: Allow demo tokens in non-production local development only
# Strictly forbidden in production (server will refuse to boot if enabled in production)
# ALLOW_DEMO_AUTH=false

# ─── SERVER RUNTIME CONFIGURATION ─────────────────────────────────────────────
# Port for the Node.js Express server (Defaults to 3000 if omitted)
PORT=3000

# Node runtime environment ('development' | 'production' | 'test')
NODE_ENV=production
