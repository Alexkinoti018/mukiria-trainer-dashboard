# ==============================================================================
# Mukiria Technical Training Institute (MTTI) / Nolimit
# Production & Local Development Environment Variables
# ==============================================================================

# ─── CLIENT-SIDE SUPABASE CONFIGURATION (Exposed to Browser via Vite) ─────────
# Full HTTPS URL to your Supabase project REST & GraphQL gateway
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Public anonymous key for client authentication and row-level security
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── SERVER-SIDE POSTGRESQL & BACKEND GATEWAY CONFIGURATION ───────────────────
# Direct PostgreSQL connection pool string (Port 5432 or 6543 for PgBouncer)
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# Alternatively, configure Supabase password directly if assembling connection string:
# SUPABASE_PROJECT_REF=your-project-id
# SUPABASE_DB_PASSWORD=your-secure-password

# Optional: Service Role Key for elevated backend migrations (NEVER expose to client)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── SERVER RUNTIME CONFIGURATION ─────────────────────────────────────────────
# Port for the Node.js Express server (Defaults to 3000 if omitted)
PORT=3000

# Node runtime environment ('development' | 'production' | 'test')
NODE_ENV=production
